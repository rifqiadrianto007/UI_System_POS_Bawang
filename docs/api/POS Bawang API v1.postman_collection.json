{
  "info": {
    "_postman_id": "pos-bawang-api-v1",
    "name": "POS Bawang API v1",
    "description": "Koleksi API v1 POS Bawang yang dibekukan pada 2026-10-22. Pilih environment POS Bawang - Local sebelum menjalankan request; perubahan kontrak memerlukan persetujuan owner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "api_prefix",
      "value": "/api/v1"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login Owner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{owner_username}}\",\n  \"password\": \"{{owner_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/auth/login",
              "host": [
                "{{base_url}}{{api_prefix}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login owner berhasil', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Token dan user tersedia', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.user.role).to.eql('owner');",
                  "    pm.environment.set('auth_token', body.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Kasir",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
