          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text",
                "exec": [
                  "pm.test('Transaksi berhasil dibuat atau idempoten', function () {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.test('Invoice dan total tersedia', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.data.invoice_no).to.be.a('string');",
                  "    pm.expect(body.data.total).to.be.a('number');",
                  "    pm.environment.set('transaction_id', body.data.id);",
                  "});"
                ]
              }
            }
          ]
        },
