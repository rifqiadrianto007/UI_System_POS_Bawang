              "mode": "raw",
              "raw": "{\n  \"client_uuid\": \"{{$guid}}\",\n  \"customer_category\": \"ecer\",\n  \"items\": [\n    { \"product_id\": {{product_id}}, \"weight_kg\": \"0.250\" }\n  ],\n  \"customer_name\": \"Bu Sari\",\n  \"payment_method\": \"cash\",\n  \"final_total\": 6900,\n  \"occurred_at\": null\n}",
              "options": {
